# ============================================================
# Local Zephr simulation
# ============================================================
# When 'true' (default in dev), src/middleware.ts fetches the real
# Finansavisen Zephr components from the URL below and splices them
# into <!-- ZEPHR_FEATURE … --> markers so you can see the FA header
# locally. In production this is left 'false' — the Zephr CDN at the
# edge handles injection.
SIMULATE_ZEPHR=true
ZEPHR_COMPONENTS_URL=https://prod-zephr-components.finansavisen.no

# ============================================================
# Login (JournalistBoost)
# ============================================================
# Every app on the FA app platform sits behind the JB login. The app does
# not implement auth — src/middleware.ts asks JB who the visitor is.
# Nothing to fill in: the default is correct in production.
# Which login this app sits behind:
#   jb    = JournalistBoost, for apps on *.apps.journalistboost.ai (default)
#   zephr = Zephr / paywall at the CDN edge, for apps on finansavisen.no
# Set this to match where the app will actually live. Getting it wrong locks
# out exactly the people the app is for.
AUTH_MODE=jb
JB_URL=https://www.journalistboost.ai
# Set to 1 ONLY for local development — you have no JB cookie on localhost.
# Must be unset/0 in production, or the app is readable by anyone.
AUTH_DISABLED=1

# ============================================================
# Database (only if the app stores data — see skills/add-database.md)
# ============================================================
# Provided by the platform in Coolify. Never fill in a real value here.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ============================================================
# GitHub — for the "save" skill
# ============================================================
# Personal Access Token with repo:write on the target repo.
# Treat this like a password. Never paste it into chat or commit it.
GITHUB_PAT=
# Full HTTPS clone URL of the journalist's repo, e.g.:
# https://github.com/<org>/<repo>.git
GIT_REMOTE=

# ============================================================
# App-level vars (extend per project)
# ============================================================
# PUBLIC_… vars are exposed to the client bundle. Everything else is
# server-only.
PORT=3000
